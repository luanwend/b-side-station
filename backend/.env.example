# Copy this file to .env and adjust the values.

# MySQL connection string: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/album_review?charset=utf8mb4

# Any long random string. Used to sign the login tokens (JWT).
JWT_SECRET_KEY=change-me-to-a-long-random-string-with-at-least-32-chars
